#!/usr/bin/env bash
# bin/create-secret — seal a secret value into the matching env file:
#   - dev  -> kubernetes/jsonnet/development/secrets.libsonnet
#   - prod -> kubernetes/jsonnet/production/secrets.libsonnet
# Each is sealed for the namespace set in that environment's config.libsonnet.
# Each item is self-describing: { name, ciphertext, envVar?, mountPath? }.
#
# DO NOT hand-edit kubernetes/jsonnet/*/secrets.libsonnet — re-run this script.
# It regenerates the whole file, so hand edits are lost.
set -euo pipefail

CONTROLLER_NS="sealed-secrets"
# Frontier cluster context (matches skaffold's kubeContext) — pin it so the cert
# is fetched from the right cluster regardless of your current kubectl context.
KUBE_CONTEXT="frontier-us-central1-k8s-api.withpersona.ts.net"
JSONNET_DIR="kubernetes/jsonnet"
CACHE_DIR="${HOME}/.cache/frontier"
CACHE_CERT="${CACHE_DIR}/sealed-secrets-cert.pem"

# Ensure a CLI is present, offering to install it via Homebrew.
ensure() {
  local bin="$1" formula="$2"
  command -v "$bin" >/dev/null && return 0
  read -rp "$bin is not installed. Install it now with Homebrew? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || { echo "$bin is required. Aborting."; exit 1; }
  command -v brew >/dev/null || { echo "Homebrew not found — install $bin manually."; exit 1; }
  brew install "$formula"
}

# jsonnet tools run from $JSONNET_DIR, which pins their versions in .tool-versions.
jsonnet_in_dir() { (cd "$JSONNET_DIR" && jsonnet "$@"); }
jsonnetfmt_in_dir() { (cd "$JSONNET_DIR" && jsonnetfmt "$@"); }

ensure kubeseal kubeseal
ensure jq jq
ensure jsonnet jsonnet
ensure jsonnetfmt jsonnet

# Paths typed at the prompts are relative to where the script was started.
START_DIR="$PWD"
cd "$(dirname "$0")/.."
[[ -d "$JSONNET_DIR" ]] || { echo "$JSONNET_DIR not found."; exit 1; }

# Tier -> environment directory.
read -rp "Is this a [p]rod or [d]ev secret? " tier
case "$tier" in
  p|P|prod) env_name="prod"; env_dir="production" ;;
  d|D|dev)  env_name="dev";  env_dir="development" ;;
  *) echo "Answer p (prod) or d (dev)."; exit 1 ;;
esac
SECRETS_FILE="$JSONNET_DIR/$env_dir/secrets.libsonnet"

# The namespace ArgoCD deploys this environment into. The ciphertext only
# decrypts there.
NS="$(jsonnet_in_dir "$env_dir/config.libsonnet" | jq -r '.namespace // ""')"
[[ -n "$NS" ]] || { echo "No namespace set in $JSONNET_DIR/$env_dir/config.libsonnet."; exit 1; }

# Printed BEFORE the value is sealed, not after. The namespace is the one input
# nobody types and the only one that can silently make the ciphertext
# undecryptable, so it has to be on screen while there is still a chance to stop.
echo "Sealing for namespace ${NS} into ${SECRETS_FILE}."

if [[ -f "$SECRETS_FILE" ]]; then
  ITEMS="$(jsonnet_in_dir "$env_dir/secrets.libsonnet" | jq -c '.secrets.sources.sealedSecrets.items // []')"
else
  ITEMS='[]'
fi

read -rp "Secret name (kebab-case [a-z0-9-]): " NAME
[[ "$NAME" =~ ^[a-z][a-z0-9-]*$ ]] || { echo "Name must be kebab-case."; exit 1; }

# Refuse silent overwrite of an existing item.
if jq -e --arg name "$NAME" 'any(.[]; .name == $name)' <<<"$ITEMS" >/dev/null; then
  read -rp "Secret '$NAME' already exists in $SECRETS_FILE. Overwrite? [y/N] " ans
  [[ "$ans" =~ ^[Yy]$ ]] || exit 0
fi

# Fetch + cache the controller's public cert (refresh daily). The cert is public,
# so this is the only step that needs cluster access.
mkdir -p "$CACHE_DIR"
if [[ ! -f "$CACHE_CERT" ]] || [[ -n "$(find "$CACHE_CERT" -mmin +1440 2>/dev/null)" ]]; then
  if ! kubeseal --fetch-cert --controller-namespace "$CONTROLLER_NS" --context "$KUBE_CONTEXT" > "$CACHE_CERT.tmp" 2>/dev/null; then
    rm -f "$CACHE_CERT.tmp"
    echo "Error: couldn't fetch the sealed-secrets cert from the Frontier cluster." >&2
    echo "Check you're on the tailnet ('tailscale status') and have run 'make setup-context', then retry." >&2
    exit 1
  fi
  mv "$CACHE_CERT.tmp" "$CACHE_CERT"
fi

# Value: a file (e.g. a multi-line .pem) or a typed single-line value.
read -rp "Path to a file holding the value (leave empty to type it instead): " VALUE_FILE
if [[ -n "$VALUE_FILE" ]]; then
  [[ "$VALUE_FILE" = /* ]] || VALUE_FILE="$START_DIR/$VALUE_FILE"
  [[ -f "$VALUE_FILE" ]] || { echo "File not found: $VALUE_FILE"; exit 1; }
  CIPHERTEXT="$(kubeseal --raw --namespace "$NS" --name "$NAME" --cert "$CACHE_CERT" < "$VALUE_FILE")"
else
  read -rsp "Secret value (hidden): " VALUE; echo
  [[ -n "$VALUE" ]] || { echo "Value is required."; exit 1; }
  CIPHERTEXT="$(printf '%s' "$VALUE" | kubeseal --raw --namespace "$NS" --name "$NAME" --cert "$CACHE_CERT")"
fi

# Prove the controller can actually decrypt this BEFORE it is written to a file
# and committed.
#
# A strict-scope ciphertext is bound to (namespace, name). Seal for the wrong
# namespace and nothing here objects: the value is written, reviewed, merged and
# deployed, and the first sign of trouble is the container stuck in
# CreateContainerConfigError while the controller logs "no key could decrypt
# secret (value)" -- a message that names neither the namespace it was sealed
# for nor where it was sealed from. Two production secrets shipped that way,
# each one holding the app on a stale revision until someone went looking.
#
# This is the only check that closes that gap, because it asks the one component
# that can answer. It costs a round trip to the cluster, which means sealing now
# requires the tailnet even when the cert is cached -- the right trade against
# committing a secret nobody has proven is readable.
echo "Validating the sealed value against the controller..."
if ! printf 'apiVersion: bitnami.com/v1alpha1\nkind: SealedSecret\nmetadata:\n  name: %s\n  namespace: %s\nspec:\n  encryptedData:\n    value: %s\n  template:\n    metadata:\n      name: %s\n    type: Opaque\n' \
     "$NAME" "$NS" "$CIPHERTEXT" "$NAME" \
   | kubeseal --validate --controller-namespace "$CONTROLLER_NS" --context "$KUBE_CONTEXT" >/dev/null 2>&1; then
  echo "Error: the controller could not decrypt the value just sealed." >&2
  echo "  namespace: $NS" >&2
  echo "  name:      $NAME" >&2
  echo "Nothing was written. Check the namespace above is this app's, from the" >&2
  echo "name in $JSONNET_DIR/common/app.libsonnet. Re-fetch the cert with" >&2
  echo "'rm -f $CACHE_CERT' if it persists." >&2
  exit 1
fi
echo "✓ validated: the controller can decrypt this."

# Optional consumer wiring — stored ON the item, so it travels with the
# ciphertext into this environment only.
DEFAULT_ENV="$(printf '%s' "$NAME" | tr '[:lower:]-' '[:upper:]_')"
ENV_VAR=""
read -rp "Expose as an env var? [Y/n] " ans
if [[ ! "$ans" =~ ^[Nn]$ ]]; then
  read -rp "Env var name [${DEFAULT_ENV}]: " ENV_VAR
  ENV_VAR="${ENV_VAR:-$DEFAULT_ENV}"
fi
MOUNT_PATH=""
read -rp "Mount as a file? [y/N] " ans
if [[ "$ans" =~ ^[Yy]$ ]]; then
  read -rp "Mount path: " MOUNT_PATH
fi

# Upsert the item, replacing any existing entry of the same name. That drops the
# replaced item's expiresAt/updatedAt/updatedBy, which described the old value;
# other items keep theirs. Every item is written in the same key order: jsonnet
# hands the existing ones back sorted, so without this each run would reorder the
# item added before it. Keys outside this list are kept, after it.
ITEMS="$(jq -c \
  --arg name "$NAME" --arg ciphertext "$CIPHERTEXT" --arg envVar "$ENV_VAR" --arg mountPath "$MOUNT_PATH" '
  ["name", "ciphertext", "envVar", "mountPath", "expiresAt", "updatedAt", "updatedBy"] as $order
  | map(select(.name != $name))
  + [{name: $name, ciphertext: $ciphertext}
     + (if $envVar != "" then {envVar: $envVar} else {} end)
     + (if $mountPath != "" then {mountPath: $mountPath} else {} end)]
  | map(. as $item
        | reduce ($order[] | select(in($item))) as $k ({}; .[$k] = $item[$k])
        + ($item | delpaths([$order[] | [.]])))
' <<<"$ITEMS")"

# Regenerate the file, keeping the previous one until the new one renders.
BACKUP=""
if [[ -f "$SECRETS_FILE" ]]; then
  BACKUP="$SECRETS_FILE.bak"
  cp "$SECRETS_FILE" "$BACKUP"
fi
{
  cat <<EOF
// ${env_name} sealed secrets, sealed for the ${NS} namespace and merged over
// ${env_dir}/config.libsonnet.
//
// Written by bin/create-secret; edits here are overwritten. Each item:
//   { name, ciphertext, envVar?, mountPath? }
// A ciphertext only decrypts in the namespace it was sealed for, so a secret
// needed in both environments must be sealed once for each.
EOF
  jq '{secrets: {sources: {sealedSecrets: {items: .}}}}' <<<"$ITEMS" | jsonnetfmt_in_dir -
} > "$SECRETS_FILE.tmp"
mv "$SECRETS_FILE.tmp" "$SECRETS_FILE"

# The entrypoint takes the imageTag ArgoCD passes; any tag renders the same
# secrets, so a placeholder does.
if ! jsonnet_in_dir -J vendor --tla-str imageTag=create-secret-check "$env_dir/main.jsonnet" >/dev/null; then
  if [[ -n "$BACKUP" ]]; then mv "$BACKUP" "$SECRETS_FILE"; else rm -f "$SECRETS_FILE"; fi
  echo "Error: $JSONNET_DIR/$env_dir/main.jsonnet no longer renders; $SECRETS_FILE left unchanged." >&2
  exit 1
fi
rm -f "$BACKUP"

echo "✓ $SECRETS_FILE: secrets.sources.sealedSecrets.items[$NAME] (namespace $NS)"
if [[ -n "$ENV_VAR" ]]; then echo "    envVar: $ENV_VAR"; fi
if [[ -n "$MOUNT_PATH" ]]; then echo "    mountPath: $MOUNT_PATH"; fi
echo
echo "The plaintext value is never written to disk — only the sealed ciphertext."
echo "Commit $SECRETS_FILE and merge to deploy. Bound to namespace $NS. A secret needed in"
echo "BOTH environments must be sealed twice — run this once for dev and once for prod."
