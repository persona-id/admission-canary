   {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
         "annotations": {
            "argocd.argoproj.io/hook": "PreSync",
            "argocd.argoproj.io/hook-delete-policy": "BeforeHookCreation,HookSucceeded"
         },
         "labels": {
            "app.kubernetes.io/instance": "billing-prod",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-billing-prod-mysql-secret"
      },
      "spec": {
         "backoffLimit": 6,
         "template": {
            "spec": {
               "containers": [
                  {
                     "args": [
                        "set -eu\napi=\"https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT_HTTPS}\"\ntoken=\"$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\"\nca=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\nexport SSL_CERT_FILE=\"${ca}\"\nauth=\"Authorization: Bearer ${token}\"\nsecret_url=\"${api}/api/v1/namespaces/${SECRET_NAMESPACE}/secrets/${SECRET_NAME}\"\nif wget -q --header=\"${auth}\" -O /dev/null \"${secret_url}\"; then\n  exit 0\nfi\npassword=\"$(head -c 48 /dev/urandom | base64 | tr -d '\\n' | head -c 48)\"\nencoded_password=\"$(printf %s \"${password}\" | base64 | tr -d '\\n')\"\nbody=\"$(printf '{\"apiVersion\":\"v1\",\"kind\":\"Secret\",\"metadata\":{\"name\":\"%s\",\"namespace\":\"%s\"},\"type\":\"Opaque\",\"data\":{\"password\":\"%s\"}}' \"${SECRET_NAME}\" \"${SECRET_NAMESPACE}\" \"${encoded_password}\")\"\nwget -q --header=\"${auth}\" --header=\"Content-Type: application/json\" --post-data=\"${body}\" -O /dev/null \"${api}/api/v1/namespaces/${SECRET_NAMESPACE}/secrets\"\n"
                     ],
                     "command": [
                        "/bin/sh",
                        "-c"
                     ],
                     "env": [
                        {
                           "name": "SECRET_NAME",
                           "value": "app-billing-prod-mysql-provisioner"
                        },
                        {
                           "name": "SECRET_NAMESPACE",
                           "value": "frontier-billing-prod"
                        }
                     ],
                     "image": "us-central1-docker.pkg.dev/persona-container-registry/mirror/alpine/mysql@sha256:08770743847a0fa8a79d79287ec07ba8cacb7ec2ea4fdaec7d97c8a51c57682b",
                     "name": "generate",
                     "securityContext": {
                        "allowPrivilegeEscalation": false
                     }
                  }
               ],
               "restartPolicy": "Never",
               "serviceAccountName": "mysql-secret-generator"
            }
         }
      }
   },
