      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "billing-prod",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "frontier.withpersona.com/owner_0": "owner",
            "frontier.withpersona.com/owner_1": "none",
            "frontier.withpersona.com/owner_2": "none",
            "frontier.withpersona.com/owner_3": "none",
            "frontier.withpersona.com/owner_4": "none",
            "frontier.withpersona.com/owner_5": "none"
         },
         "name": "cloud-sql-proxy-ro"
      },
      "spec": {
         "replicas": 2,
         "selector": {
            "matchLabels": {
               "frontier.withpersona.com/workload": "cloud-sql-proxy-ro"
            }
         },
         "template": {
            "metadata": {
               "annotations": {
                  "frontier.withpersona.com/mysql-connection-name": "persona-frontier:us-central1:frontier-billing-prod"
               },
               "labels": {
                  "app.kubernetes.io/instance": "billing-prod",
                  "app.kubernetes.io/managed-by": "tanka",
                  "app.kubernetes.io/name": "frontier-app-base",
                  "frontier.withpersona.com/workload": "cloud-sql-proxy-ro"
               }
            },
            "spec": {
               "affinity": {
                  "podAntiAffinity": {
                     "preferredDuringSchedulingIgnoredDuringExecution": [
                        {
                           "podAffinityTerm": {
                              "labelSelector": {
                                 "matchLabels": {
                                    "frontier.withpersona.com/workload": "cloud-sql-proxy-ro"
                                 }
                              },
                              "topologyKey": "kubernetes.io/hostname"
                           },
                           "weight": 100
                        }
                     ]
                  }
               },
               "containers": [
                  {
                     "args": [
                        "--auto-iam-authn",
                        "--address=0.0.0.0",
                        "--health-check",
                        "--http-address=0.0.0.0",
                        "--http-port=9091",
                        "--max-sigterm-delay=290s",
                        "--private-ip",
                        "--structured-logs",
                        "--port=3306",
                        "$(INSTANCE_CONNECTION_NAME)"
                     ],
                     "env": [
                        {
                           "name": "INSTANCE_CONNECTION_NAME",
                           "valueFrom": {
                              "configMapKeyRef": {
                                 "key": "instanceConnectionName",
                                 "name": "mysql-connection"
                              }
                           }
                        }
                     ],
                     "image": "us-central1-docker.pkg.dev/persona-container-registry/mirror/cloud-sql-connectors/cloud-sql-proxy@sha256:ef8786bd894cf1746b432f9eb9e4cb6b50c48629eed75789734f3a7b8df7de28",
                     "livenessProbe": {
                        "httpGet": {
                           "path": "/liveness",
                           "port": 9091
                        },
                        "periodSeconds": 10,
                        "timeoutSeconds": 5
                     },
                     "name": "cloud-sql-proxy",
                     "readinessProbe": {
                        "httpGet": {
                           "path": "/readiness",
                           "port": 9091
                        },
                        "periodSeconds": 10,
                        "timeoutSeconds": 5
                     },
                     "resources": {
                        "limits": {
                           "cpu": "160m",
                           "memory": "64Mi"
                        },
                        "requests": {
                           "cpu": "100m",
                           "memory": "32Mi"
                        }
                     },
                     "securityContext": {
                        "allowPrivilegeEscalation": false,
                        "runAsNonRoot": true
                     },
                     "startupProbe": {
                        "failureThreshold": 30,
                        "httpGet": {
                           "path": "/startup",
                           "port": 9091
                        },
                        "periodSeconds": 1,
                        "timeoutSeconds": 5
                     }
                  }
               ],
               "serviceAccountName": "cloud-sql-proxy-ro",
               "terminationGracePeriodSeconds": 305
            }
         }
      }
