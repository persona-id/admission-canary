                           "memory": "64Mi"
                        },
                        "requests": {
                           "cpu": "100m",
                           "memory": "32Mi"
                        }
                     },
                     "securityContext": {
                        "allowPrivilegeEscalation": false,
                        "runAsNonRoot": true
                     },
                     "startupProbe": {
                        "failureThreshold": 30,
                        "httpGet": {
                           "path": "/startup",
                           "port": 9091
                        },
                        "periodSeconds": 1,
                        "timeoutSeconds": 5
                     }
                  }
               ],
               "serviceAccountName": "cloud-sql-proxy",
               "terminationGracePeriodSeconds": 305
            }
         }
