                        "--address=0.0.0.0",
                        "--health-check",
                        "--http-address=0.0.0.0",
                        "--http-port=9091",
                        "--max-sigterm-delay=290s",
                        "--private-ip",
                        "--structured-logs",
                        "--port=3306",
                        "$(INSTANCE_CONNECTION_NAME)"
