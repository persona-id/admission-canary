[
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "allow-intra-namespace"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "namespaces": [
                           "demo-prod"
                        ]
                     }
                  }
               ]
            }
         ]
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-s2s"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "paths": [
                           "/metrics",
                           "/healthz"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz"
                        ],
                        "paths": [
                           "/*"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "principals": [
                           "cluster.local/ns/knative-serving/sa/activator",
                           "cluster.local/ns/knative-serving/sa/controller"
                        ]
                     }
                  }
               ]
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
         "labels": {
            "app": "demo",
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "environment": "development",
            "homestead.withpersona.com/catalog": "prod",
            "istio.io/rev": "stable",
            "name": "demo-prod"
         },
         "name": "demo-prod"
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "PeerAuthentication",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-mtls-strict"
      },
      "spec": {
         "mtls": {
            "mode": "STRICT"
         },
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "policy/v1",
      "kind": "PodDisruptionBudget",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app"
      },
      "spec": {
         "maxUnavailable": 1,
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-crd-access"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "frontier-namespace-owner"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-edit"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "edit"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "serving.knative.dev/v1",
      "kind": "Service",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "knative.withpersona.com/visibility": "private"
         },
         "name": "app"
      },
      "spec": {
         "template": {
            "metadata": {
               "annotations": {
                  "autoscaling.knative.dev/minScale": "2",
                  "autoscaling.knative.dev/target-burst-capacity": "0"
               },
               "labels": {
                  "environment": "production"
               }
            },
            "spec": {
               "containers": [
                  {
                     "image": "r:t",
                     "livenessProbe": {
                        "httpGet": {
                           "path": "/healthz",
                           "port": 3000
                        }
                     },
                     "ports": [
                        {
                           "containerPort": 3000
                        }
                     ],
                     "readinessProbe": {
                        "httpGet": {
                           "path": "/readyz"
                        },
                        "periodSeconds": 5
                     },
                     "startupProbe": {
                        "failureThreshold": 30,
                        "tcpSocket": {
                           "port": 3000
                        }
                     }
                  }
               ],
               "nodeSelector": {
                  "cloud.google.com/compute-class": "standard"
               },
               "serviceAccountName": "app",
               "timeoutSeconds": 300,
               "tolerations": [
                  {
                     "effect": "NoSchedule",
                     "key": "cloud.google.com/compute-class",
                     "operator": "Equal",
                     "value": "standard"
                  }
               ]
            }
         },
         "traffic": [
            {
               "latestRevision": true,
               "percent": 100
            }
         ]
      }
   },
   {
      "apiVersion": "v1",
      "imagePullSecrets": [
         {
            "name": "ghcr-pull-secret"
         }
      ],
      "kind": "ServiceAccount",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app"
      }
   }
]
