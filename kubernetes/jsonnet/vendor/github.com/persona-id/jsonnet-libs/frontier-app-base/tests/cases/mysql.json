                     "serviceAccountName": "app",
                     "tolerations": [
                        {
                           "effect": "NoSchedule",
                           "key": "cloud.google.com/compute-class",
                           "operator": "Equal",
                           "value": "standard"
                        }
                     ]
                  }
               }
            }
         },
         "schedule": "0 3 * * *",
         "successfulJobsHistoryLimit": 3,
         "suspend": false
