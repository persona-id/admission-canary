      "spec": {
         "backoffLimit": 6,
         "template": {
            "spec": {
               "containers": [
                  {
                     "args": [
                        "set -eu\napi=\"https://${KUBERNETES_SERVICE_HOST}:${KUBERNETES_SERVICE_PORT_HTTPS}\"\ntoken=\"$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)\"\nca=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\nauth=\"Authorization: Bearer ${token}\"\nsecret_url=\"${api}/api/v1/namespaces/${SECRET_NAMESPACE}/secrets/${SECRET_NAME}\"\nif curl --fail --silent --show-error --cacert \"${ca}\" --header \"${auth}\" --output /dev/null \"${secret_url}\"; then\n  exit 0\nfi\npassword=\"$(head -c 48 /dev/urandom | base64 | tr -d '\\n' | head -c 48)\"\nencoded_password=\"$(printf %s \"${password}\" | base64 | tr -d '\\n')\"\nbody=\"$(printf '{\"apiVersion\":\"v1\",\"kind\":\"Secret\",\"metadata\":{\"name\":\"%s\",\"namespace\":\"%s\"},\"type\":\"Opaque\",\"data\":{\"password\":\"%s\"}}' \"${SECRET_NAME}\" \"${SECRET_NAMESPACE}\" \"${encoded_password}\")\"\ncurl --fail --silent --show-error --cacert \"${ca}\" --header \"${auth}\" --header \"Content-Type: application/json\" --data \"${body}\" \"${api}/api/v1/namespaces/${SECRET_NAMESPACE}/secrets\"\n"
                     ],
                     "command": [
                        "/bin/sh",
                        "-c"
                     ],
                     "env": [
                        {
                           "name": "SECRET_NAME",
                           "value": "app-persona-billing-prod-mysql-provisioner"
                        },
                        {
                           "name": "SECRET_NAMESPACE",
                           "value": "frontier-persona-billing-prod"
                        }
                     ],
                     "image": "us-central1-docker.pkg.dev/persona-container-registry/mirror/curlimages/curl@sha256:463eaf6072688fe96ac64fa623fe73e1dbe25d8ad6c34404a669ad3ce1f104b6",
                     "name": "generate",
                     "securityContext": {
                        "allowPrivilegeEscalation": false
                     }
                  }
               ],
               "restartPolicy": "Never",
               "serviceAccountName": "mysql-secret-generator"
            }
         }
      }
   },
