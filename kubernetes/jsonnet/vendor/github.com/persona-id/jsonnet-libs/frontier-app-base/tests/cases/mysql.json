   {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
         "annotations": {
            "argocd.argoproj.io/hook": "Sync",
            "argocd.argoproj.io/hook-delete-policy": "BeforeHookCreation,HookSucceeded",
            "argocd.argoproj.io/sync-wave": "0"
         },
         "labels": {
            "app.kubernetes.io/instance": "persona-billing-prod",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-persona-billing-prod-mysql-grants"
      },
      "spec": {
         "activeDeadlineSeconds": 2400,
         "backoffLimit": 2,
         "template": {
            "metadata": {
               "labels": {
                  "app.kubernetes.io/instance": "persona-billing-prod",
                  "app.kubernetes.io/managed-by": "tanka",
                  "app.kubernetes.io/name": "frontier-mysql-provisioner"
               }
            },
            "spec": {
               "containers": [
                  {
                     "args": [
                        "set -eu\ni=0\nwhile [ \"$i\" -lt 60 ]; do\n  if mysql --protocol=TCP --skip-ssl --host=127.0.0.1 --user=mysql-provisioner --password=\"$MYSQL_PROVISIONER_PASSWORD\" --execute=\"GRANT ALL PRIVILEGES ON \\`$MYSQL_DATABASE\\`.* TO '$MYSQL_USER'@'%'\"; then\n    exit 0\n  fi\n  i=$((i + 1))\n  sleep 10\ndone\nexit 1\n"
                     ],
                     "command": [
                        "/bin/sh",
                        "-c"
                     ],
                     "env": [
                        {
                           "name": "MYSQL_DATABASE",
                           "value": "persona-billing-prod"
                        },
                        {
                           "name": "MYSQL_USER",
                           "value": "app-persona-billing-prod"
                        },
                        {
                           "name": "MYSQL_PROVISIONER_PASSWORD",
                           "valueFrom": {
                              "secretKeyRef": {
                                 "key": "password",
                                 "name": "app-persona-billing-prod-mysql-provisioner"
                              }
                           }
                        }
                     ],
                     "image": "us-central1-docker.pkg.dev/persona-container-registry/mirror/alpine/mysql@sha256:08770743847a0fa8a79d79287ec07ba8cacb7ec2ea4fdaec7d97c8a51c57682b",
                     "name": "grant",
                     "securityContext": {
                        "allowPrivilegeEscalation": false
                     }
                  }
               ],
               "initContainers": [
                  {
                     "args": [
                        "--health-check",
                        "--http-address=0.0.0.0",
                        "--http-port=9091",
                        "--private-ip",
                        "--port=3306",
                        "persona-frontier-staging:us-central1:frontier-persona-billing-prod"
                     ],
                     "image": "us-central1-docker.pkg.dev/persona-container-registry/mirror/cloud-sql-connectors/cloud-sql-proxy@sha256:ef8786bd894cf1746b432f9eb9e4cb6b50c48629eed75789734f3a7b8df7de28",
                     "name": "cloud-sql-proxy",
                     "restartPolicy": "Always",
                     "securityContext": {
                        "allowPrivilegeEscalation": false,
                        "runAsNonRoot": true
                     },
                     "startupProbe": {
                        "failureThreshold": 1800,
                        "httpGet": {
                           "path": "/startup",
                           "port": 9091
                        },
                        "periodSeconds": 1
                     }
                  }
               ],
               "restartPolicy": "Never",
               "serviceAccountName": "app"
            }
         }
      }
   },
