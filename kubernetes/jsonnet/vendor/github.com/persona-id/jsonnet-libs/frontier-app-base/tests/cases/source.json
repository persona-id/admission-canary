[
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "allow-intra-namespace"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "namespaces": [
                           "demo-dev"
                        ]
                     }
                  }
               ]
            }
         ]
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-s2s"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "paths": [
                           "/metrics",
                           "/healthz"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz"
                        ],
                        "paths": [
                           "/*"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "principals": [
                           "cluster.local/ns/knative-serving/sa/activator",
                           "cluster.local/ns/knative-serving/sa/controller"
                        ]
                     }
                  }
               ]
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
         "labels": {
            "app": "demo",
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "environment": "development",
            "homestead.withpersona.com/catalog": "prod",
            "istio.io/rev": "stable",
            "name": "demo-dev"
         },
         "name": "demo-dev"
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "PeerAuthentication",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-mtls-strict"
      },
      "spec": {
         "mtls": {
            "mode": "STRICT"
         },
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-crd-access"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "frontier-namespace-owner"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-edit"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "edit"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
         "annotations": {
            "frontier.withpersona.com/source-dirty": "false",
            "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "org.opencontainers.image.source": "https://github.com/persona-id/demo"
         },
         "labels": {
            "app.kubernetes.io/component": "scheduled-job",
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "frontier.withpersona.com/workload": "nightly"
         },
         "name": "nightly"
      },
      "spec": {
         "concurrencyPolicy": "Forbid",
         "failedJobsHistoryLimit": 1,
         "jobTemplate": {
            "metadata": {
               "annotations": {
                  "frontier.withpersona.com/source-dirty": "false",
                  "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                  "org.opencontainers.image.source": "https://github.com/persona-id/demo"
               },
               "labels": {
                  "app.kubernetes.io/component": "scheduled-job",
                  "app.kubernetes.io/instance": "demo",
                  "app.kubernetes.io/managed-by": "tanka",
                  "app.kubernetes.io/name": "frontier-app-base",
                  "frontier.withpersona.com/workload": "nightly"
               }
            },
            "spec": {
               "backoffLimit": 3,
               "template": {
                  "metadata": {
                     "annotations": {
                        "custom": "job",
                        "frontier.withpersona.com/source-dirty": "false",
                        "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                        "org.opencontainers.image.source": "https://github.com/persona-id/demo"
                     },
                     "labels": {
                        "app.kubernetes.io/component": "scheduled-job",
                        "app.kubernetes.io/instance": "demo",
                        "app.kubernetes.io/managed-by": "tanka",
                        "app.kubernetes.io/name": "frontier-app-base",
                        "environment": "development",
                        "frontier.withpersona.com/workload": "nightly"
                     }
                  },
                  "spec": {
                     "containers": [
                        {
                           "env": [
                              {
                                 "name": "DD_GIT_COMMIT_SHA",
                                 "value": "override"
                              },
                              {
                                 "name": "DD_GIT_REPOSITORY_URL",
                                 "value": "https://github.com/persona-id/demo"
                              }
                           ],
                           "image": "ghcr.io/persona-id/demo:abc123",
                           "name": "job",
                           "resources": {
                              "limits": {
                                 "memory": "512Mi"
                              },
                              "requests": {
                                 "cpu": "100m",
                                 "memory": "256Mi"
                              }
                           }
                        }
                     ],
                     "nodeSelector": {
                        "cloud.google.com/compute-class": "standard"
                     },
                     "restartPolicy": "Never",
                     "serviceAccountName": "app",
                     "tolerations": [
                        {
                           "effect": "NoSchedule",
                           "key": "cloud.google.com/compute-class",
                           "operator": "Equal",
                           "value": "standard"
                        }
                     ]
                  }
               }
            }
         },
         "schedule": "0 2 * * *",
         "successfulJobsHistoryLimit": 3,
         "suspend": false
      }
   },
   {
      "apiVersion": "serving.knative.dev/v1",
      "kind": "Service",
      "metadata": {
         "annotations": {
            "frontier.withpersona.com/source-dirty": "false",
            "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "org.opencontainers.image.source": "https://github.com/persona-id/demo"
         },
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "knative.withpersona.com/visibility": "private"
         },
         "name": "app"
      },
      "spec": {
         "template": {
            "metadata": {
               "annotations": {
                  "autoscaling.knative.dev/minScale": "1",
                  "autoscaling.knative.dev/target-burst-capacity": "0",
                  "frontier.withpersona.com/source-dirty": "false",
                  "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                  "org.opencontainers.image.source": "https://github.com/persona-id/demo"
               },
               "labels": {
                  "environment": "development"
               }
            },
            "spec": {
               "containers": [
                  {
                     "env": [
                        {
                           "name": "DD_GIT_COMMIT_SHA",
                           "value": "override"
                        },
                        {
                           "name": "DD_GIT_REPOSITORY_URL",
                           "value": "https://github.com/persona-id/demo"
                        }
                     ],
                     "image": "ghcr.io/persona-id/demo:abc123",
                     "ports": [
                        {
                           "containerPort": 8080
                        }
                     ]
                  }
               ],
               "nodeSelector": {
                  "cloud.google.com/compute-class": "standard"
               },
               "serviceAccountName": "app",
               "timeoutSeconds": 300,
               "tolerations": [
                  {
                     "effect": "NoSchedule",
                     "key": "cloud.google.com/compute-class",
                     "operator": "Equal",
                     "value": "standard"
                  }
               ]
            }
         },
         "traffic": [
            {
               "latestRevision": true,
               "percent": 100
            }
         ]
      }
   },
   {
      "apiVersion": "v1",
      "imagePullSecrets": [
         {
            "name": "ghcr-pull-secret"
         }
      ],
      "kind": "ServiceAccount",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app"
      }
   },
   {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
         "annotations": {
            "frontier.withpersona.com/source-dirty": "false",
            "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "org.opencontainers.image.source": "https://github.com/persona-id/demo"
         },
         "labels": {
            "app.kubernetes.io/component": "worker",
            "app.kubernetes.io/instance": "demo",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "frontier.withpersona.com/workload": "consumer"
         },
         "name": "consumer"
      },
      "spec": {
         "replicas": 1,
         "selector": {
            "matchLabels": {
               "frontier.withpersona.com/workload": "consumer"
            }
         },
         "template": {
            "metadata": {
               "annotations": {
                  "custom": "worker",
                  "frontier.withpersona.com/source-dirty": "false",
                  "org.opencontainers.image.revision": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
                  "org.opencontainers.image.source": "https://github.com/persona-id/demo"
               },
               "labels": {
                  "app.kubernetes.io/component": "worker",
                  "app.kubernetes.io/instance": "demo",
                  "app.kubernetes.io/managed-by": "tanka",
                  "app.kubernetes.io/name": "frontier-app-base",
                  "environment": "development",
                  "frontier.withpersona.com/workload": "consumer"
               }
            },
            "spec": {
               "containers": [
                  {
                     "env": [
                        {
                           "name": "DD_GIT_COMMIT_SHA",
                           "value": "worker-override"
                        },
                        {
                           "name": "DD_GIT_REPOSITORY_URL",
                           "value": "https://github.com/persona-id/demo"
                        }
                     ],
                     "image": "ghcr.io/persona-id/demo:abc123",
                     "name": "worker",
                     "resources": {
                        "limits": {
                           "memory": "512Mi"
                        },
                        "requests": {
                           "cpu": "100m",
                           "memory": "256Mi"
                        }
                     }
                  }
               ],
               "nodeSelector": {
                  "cloud.google.com/compute-class": "standard"
               },
               "serviceAccountName": "app",
               "terminationGracePeriodSeconds": 30,
               "tolerations": [
                  {
                     "effect": "NoSchedule",
                     "key": "cloud.google.com/compute-class",
                     "operator": "Equal",
                     "value": "standard"
                  }
               ]
            }
         }
      }
   }
]
