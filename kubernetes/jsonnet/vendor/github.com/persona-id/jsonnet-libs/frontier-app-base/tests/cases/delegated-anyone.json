[
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "allow-intra-namespace"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "namespaces": [
                           "demo-prod"
                        ]
                     }
                  }
               ]
            }
         ]
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-s2s"
      },
      "spec": {
         "action": "ALLOW",
         "rules": [
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "paths": [
                           "/metrics",
                           "/healthz"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal"
                        ],
                        "requestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/other-app"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "paths": [
                           "/metrics",
                           "/healthz"
                        ]
                     }
                  }
               ],
               "when": [
                  {
                     "key": "request.auth.claims[forge_delegated]",
                     "values": [
                        "true"
                     ]
                  },
                  {
                     "key": "request.auth.claims[forge_user_email]",
                     "values": [
                        "*"
                     ]
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "notRequestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/*"
                        ],
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal",
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-external"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz"
                        ],
                        "paths": [
                           "/*"
                        ]
                     }
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "principals": [
                           "cluster.local/ns/istio-gateways/sa/istio-ingressgateway-internal"
                        ],
                        "requestPrincipals": [
                           "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev/other-app"
                        ]
                     }
                  }
               ],
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz"
                        ],
                        "paths": [
                           "/*"
                        ]
                     }
                  }
               ],
               "when": [
                  {
                     "key": "request.auth.claims[forge_delegated]",
                     "values": [
                        "true"
                     ]
                  },
                  {
                     "key": "request.auth.claims[forge_user_email]",
                     "values": [
                        "*"
                     ]
                  }
               ]
            },
            {
               "from": [
                  {
                     "source": {
                        "principals": [
                           "cluster.local/ns/knative-serving/sa/activator",
                           "cluster.local/ns/knative-serving/sa/controller"
                        ]
                     }
                  }
               ]
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "networking.istio.io/v1alpha3",
      "kind": "EnvoyFilter",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-forge-header-sanitizer"
      },
      "spec": {
         "configPatches": [
            {
               "applyTo": "HTTP_FILTER",
               "match": {
                  "context": "SIDECAR_INBOUND",
                  "listener": {
                     "filterChain": {
                        "filter": {
                           "name": "envoy.filters.network.http_connection_manager"
                        }
                     }
                  }
               },
               "patch": {
                  "operation": "INSERT_FIRST",
                  "value": {
                     "name": "frontier.filters.http.forge_header_sanitizer",
                     "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua",
                        "defaultSourceCode": {
                           "inlineString": "function envoy_on_request(handle)\n  local headers = handle:headers()\n  headers:remove(\"x-forge-caller\")\n  headers:remove(\"x-forge-user-email\")\n  headers:remove(\"x-forge-user-groups\")\n  -- Preserve browser oauth2-proxy identity. Forge passes must\n  -- never carry an independent caller-supplied Okta identity.\n  if headers:get(\"x-forge-identity\") ~= nil then\n    headers:remove(\"x-auth-request-user\")\n    headers:remove(\"x-auth-request-email\")\n    headers:remove(\"x-auth-request-groups\")\n    headers:remove(\"x-auth-request-preferred-username\")\n    headers:remove(\"x-auth-request-access-token\")\n    headers:remove(\"x-auth-request-redirect\")\n  end\nend\n"
                        }
                     }
                  }
               }
            }
         ],
         "workloadSelector": {
            "labels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "RequestAuthentication",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-forge-identity"
      },
      "spec": {
         "jwtRules": [
            {
               "audiences": [
                  "demo-prod"
               ],
               "forwardOriginalToken": false,
               "fromHeaders": [
                  {
                     "name": "x-forge-identity"
                  }
               ],
               "issuer": "https://persona-cf-app-forge-identity-prod.persona-app.workers.dev",
               "jwks": "{\"keys\":[{\"alg\":\"ES256\",\"crv\":\"P-256\",\"kid\":\"persona-cf-app-forge-identity.UaiwbHC9ncPRNLvyu7xqkgaaShz-JFDynppBLQwWtUE\",\"kty\":\"EC\",\"use\":\"sig\",\"x\":\"IXebg7TgZyIOYe-FXmcDbYSDmKMDijZVVPoitcWAp3U\",\"y\":\"Lrhm0qqB0BJ2YYBg9zim1bjeG85Wy4y0lRymToMpPYo\"}]}",
               "outputClaimToHeaders": [
                  {
                     "claim": "sub",
                     "header": "x-forge-caller"
                  },
                  {
                     "claim": "forge_user_email",
                     "header": "x-forge-user-email"
                  },
                  {
                     "claim": "forge_user_groups_csv",
                     "header": "x-forge-user-groups"
                  }
               ]
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "networking.istio.io/v1",
      "kind": "VirtualService",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-forge"
      },
      "spec": {
         "gateways": [
            "istio-gateways/istio-forge-gateway"
         ],
         "hosts": [
            "app.demo-prod.svc.cluster.local"
         ],
         "http": [
            {
               "headers": {
                  "request": {
                     "remove": [
                        "x-auth-request-user",
                        "x-auth-request-email",
                        "x-auth-request-groups",
                        "x-auth-request-preferred-username",
                        "x-auth-request-access-token",
                        "x-auth-request-redirect",
                        "x-forge-caller",
                        "x-forge-user-email",
                        "x-forge-user-groups"
                     ]
                  }
               },
               "route": [
                  {
                     "destination": {
                        "host": "app.demo-prod.svc.cluster.local",
                        "port": {
                           "number": 80
                        }
                     }
                  }
               ]
            }
         ]
      }
   },
   {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
         "labels": {
            "app": "demo",
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "environment": "development",
            "homestead.withpersona.com/catalog": "prod",
            "istio.io/rev": "stable",
            "name": "demo-prod"
         },
         "name": "demo-prod"
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "PeerAuthentication",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-mtls-strict"
      },
      "spec": {
         "mtls": {
            "mode": "STRICT"
         },
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-crd-access"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "frontier-namespace-owner"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-edit"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "edit"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "serving.knative.dev/v1",
      "kind": "Service",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "knative.withpersona.com/visibility": "private"
         },
         "name": "app"
      },
      "spec": {
         "template": {
            "metadata": {
               "annotations": {
                  "autoscaling.knative.dev/minScale": "1",
                  "autoscaling.knative.dev/target-burst-capacity": "0"
               },
               "labels": {
                  "environment": "production"
               }
            },
            "spec": {
               "containers": [
                  {
                     "image": "r:t",
                     "ports": [
                        {
                           "containerPort": 8080
                        }
                     ]
                  }
               ],
               "nodeSelector": {
                  "cloud.google.com/compute-class": "standard"
               },
               "serviceAccountName": "app",
               "timeoutSeconds": 300,
               "tolerations": [
                  {
                     "effect": "NoSchedule",
                     "key": "cloud.google.com/compute-class",
                     "operator": "Equal",
                     "value": "standard"
                  }
               ]
            }
         },
         "traffic": [
            {
               "latestRevision": true,
               "percent": 100
            }
         ]
      }
   },
   {
      "apiVersion": "v1",
      "imagePullSecrets": [
         {
            "name": "ghcr-pull-secret"
         }
      ],
      "kind": "ServiceAccount",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app"
      }
   }
]
