            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-crd-access"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "frontier-namespace-owner"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "owner-edit"
      },
      "roleRef": {
         "apiGroup": "rbac.authorization.k8s.io",
         "kind": "ClusterRole",
         "name": "edit"
      },
      "subjects": [
         {
            "apiGroup": "rbac.authorization.k8s.io",
            "kind": "User",
            "name": "owner@withpersona.com"
         }
      ]
   },
   {
      "apiVersion": "serving.knative.dev/v1",
      "kind": "Service",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base",
            "knative.withpersona.com/visibility": "private"
         },
         "name": "app"
      },
      "spec": {
         "template": {
            "metadata": {
               "annotations": {
                  "autoscaling.knative.dev/maxScale": "3",
                  "autoscaling.knative.dev/minScale": "1",
                  "autoscaling.knative.dev/target-burst-capacity": "0"
               },
               "labels": {
                  "environment": "production",
                  "frontier.withpersona.com/custom-denied-message": "true"
               }
            },
            "spec": {
               "containers": [
                  {
                     "image": "r:t",
                     "ports": [
                        {
                           "containerPort": 8080
                        }
                     ]
                  }
               ],
               "nodeSelector": {
                  "cloud.google.com/compute-class": "standard"
               },
               "serviceAccountName": "app",
               "timeoutSeconds": 300,
               "tolerations": [
                  {
                     "effect": "NoSchedule",
                     "key": "cloud.google.com/compute-class",
                     "operator": "Equal",
                     "value": "standard"
                  }
               ]
            }
         },
         "traffic": [
            {
               "latestRevision": true,
               "percent": 100
            }
         ]
      }
   },
   {
      "apiVersion": "v1",
      "imagePullSecrets": [
         {
            "name": "ghcr-pull-secret"
         }
      ],
      "kind": "ServiceAccount",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app"
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "RequestAuthentication",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-okta-jwt"
      },
      "spec": {
         "jwtRules": [
            {
               "forwardOriginalToken": false,
               "issuer": "https://persona.okta.com",
               "jwksUri": "https://persona.okta.com/oauth2/v1/keys"
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   },
   {
      "apiVersion": "security.istio.io/v1",
      "kind": "AuthorizationPolicy",
      "metadata": {
         "labels": {
            "app.kubernetes.io/instance": "rel",
            "app.kubernetes.io/managed-by": "tanka",
            "app.kubernetes.io/name": "frontier-app-base"
         },
         "name": "app-require-auth"
      },
      "spec": {
         "action": "CUSTOM",
         "provider": {
            "name": "oauth2-proxy"
         },
         "rules": [
            {
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz",
                           "/api/internal/*",
                           "/webhooks"
                        ],
                        "paths": [
                           "/admin/*"
                        ]
                     }
                  }
               ]
            },
            {
               "to": [
                  {
                     "operation": {
                        "notPaths": [
                           "/metrics",
                           "/healthz",
                           "/api/internal/*",
                           "/webhooks",
                           "/admin/*"
                        ],
                        "paths": [
                           "/*"
                        ]
                     }
                  }
               ]
            }
         ],
         "selector": {
            "matchLabels": {
               "serving.knative.dev/service": "app"
            }
         }
      }
   }
]
